# ==============================
# Flask Configuration
# ==============================
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=face-mask-attendance-super-secret-key-change-in-production-2024

# ==============================
# PostgreSQL Database
# ==============================
DATABASE_URL=postgresql://postgres:Admin@localhost:5432/face_attendance_db

# ==============================
# ML Model Paths
# ==============================
FACE_DETECTOR_MODEL=yolov8n-face.pt
MASK_DETECTOR_MODEL=mask_detector.pt
ARCFACE_MODEL=buffalo_l

# ==============================
# Face Recognition Settings
# ==============================
RECOGNITION_THRESHOLD=0.55
MIN_FACE_SIZE=0.3
FACE_CAPTURE_COUNT=5

# ==============================
# Upload Settings
# ==============================
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# ==============================
# Admin Defaults
# ==============================
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@faceattendance.com
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_FULLNAME=System Administrator
